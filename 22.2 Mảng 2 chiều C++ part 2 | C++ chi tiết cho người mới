#include<iostream>
#include <random>
using namespace std;
int main() {
	const int row=3;
	const int col=4;
	// 4. Tạo mảng với các phần tử do người nhập từ bàn phím
	int mang6[row][col];
	// duyệt từng phần tử và cho phép nhập từ bàn phím
	for (int i = 0; i < row; i++) {
		for (int j = 0; j < col; j++) {
			cout << "Mang [" << i << "][" << j << "]: ";
			cin >> mang6[i][j];
		}
	}
	// xuất mảng vừa nhập
	for (int i = 0; i < row; i++) {
		for (int j = 0; j < col; j++) {
			cout << mang6[i][j] << " ";

		}
		cout << endl;
	}
	// Xuất theo dòng
	int dong;
	cout << "dong ban muon hien la: ";
	cin >> dong;
	for (int j = 0; j < col; j++) {
		cout << mang6[dong][j] << " ";
	}

}
